# === Supabase / Postgres ===
# Connection string cho Drizzle (dùng bản "Connection pooling" / "Session" của Supabase).
# Lấy tại: Supabase Dashboard → Project Settings → Database → Connection string (URI).
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Public config cho client (dùng khi làm Auth ở P8)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON-KEY]"

# Service role key — CHỈ dùng ở server/seed script, KHÔNG expose ra client
SUPABASE_SERVICE_ROLE_KEY="[SERVICE-ROLE-KEY]"
