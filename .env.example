# === Supabase / Postgres ===
# Connection string cho Drizzle.
#
# 🔴 PHẢI dùng "Transaction pooler" — cổng 6543, KHÔNG phải Session pooler (5432).
# Session mode cấp hẳn 1 kết nối Postgres cho mỗi client và trần chỉ 15 client;
# trên Vercel (serverless, nhiều instance) sẽ vỡ trần ngay và mọi truy vấn ném
# lỗi "(EMAXCONNSESSION) max clients reached" — đã làm sập deploy 2026-07-31.
#
# Lấy tại: Supabase Dashboard → Connect → Transaction pooler.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Ghi chú: máy local có thể vẫn để cổng 5432 (Session pooler) vì drizzle-kit
# (generate/push/migrate/studio) cần phiên giữ trạng thái, còn Transaction
# pooler thì không hỗ trợ. Chỉ MÔI TRƯỜNG DEPLOY mới bắt buộc dùng 6543.

# Public config cho client (dùng khi làm Auth ở P8)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON-KEY]"

# Service role key — CHỈ dùng ở server/seed script, KHÔNG expose ra client.
# BẮT BUỘC phải có thì màn "Quản lý nhân viên" mới cấp được tài khoản đăng nhập.
# Lấy tại: Supabase Dashboard → Project Settings → API keys → service_role.
SUPABASE_SERVICE_ROLE_KEY="[SERVICE-ROLE-KEY]"

# === Phân quyền ===
# Email của tài khoản quản lý (dùng chung của phòng Sale) — người duy nhất
# thấy menu "Quản lý nhân viên" và cấp/thu tài khoản được.
# Nhiều tài khoản thì ngăn cách bằng dấu phẩy. Bỏ trống = mặc định sale@drkam.vn.
MANAGER_EMAILS="sale@drkam.vn"
