# === Supabase / Postgres ===
# Connection string cho Drizzle — dùng "Session pooler", cổng 5432.
# Lấy tại: Supabase Dashboard → Connect → Session pooler.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# 🔴 Bài học 2026-07-31 — deploy từng sập vì hết kết nối:
#   Supabase pooler chỉ cho 15 client, mà postgres.js mặc định mở 10 kết nối
#   mỗi client. Trên Vercel vài instance chạy song song là vỡ trần, mọi truy
#   vấn ném "(EMAXCONNSESSION) max clients reached".
#   → Đã sửa bằng `max: 1` trong src/db/index.ts, KHÔNG phải bằng đổi cổng.
#
#   ĐỪNG đổi sang Transaction pooler (6543): local chạy được nhưng trên Vercel
#   mọi request treo tới khi hết 300s. drizzle-kit cũng cần cổng 5432.

# Public config cho client (dùng khi làm Auth ở P8)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON-KEY]"

# Service role key — CHỈ dùng ở server/seed script, KHÔNG expose ra client.
# BẮT BUỘC phải có thì màn "Quản lý nhân viên" mới cấp được tài khoản đăng nhập.
# Lấy tại: Supabase Dashboard → Project Settings → API keys → service_role.
SUPABASE_SERVICE_ROLE_KEY="[SERVICE-ROLE-KEY]"

# === Phân quyền ===
# Email của tài khoản quản lý (dùng chung của phòng Sale) — người duy nhất
# thấy menu "Quản lý nhân viên" và cấp/thu tài khoản được.
# Nhiều tài khoản thì ngăn cách bằng dấu phẩy. Bỏ trống = mặc định sale@drkam.vn.
MANAGER_EMAILS="sale@drkam.vn"
